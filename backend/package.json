  "description": "Cricket Management Platform Backend API & Foundation",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "tsx test-phase5.ts",
    "test:all": "tsx test-phase0.ts && tsx test-phase1.ts && tsx test-phase1-hardening.ts && tsx test-phase2.ts && tsx test-phase3.ts && tsx test-phase4.ts && tsx test-phase5.ts",
    "db:generate": "prisma generate",
